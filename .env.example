# Model under test for this run. Must be one of the CANDIDATE_MODELS
MODEL=gemma3:4b

# Cascade (Assignment 2). Leave CASCADE_SMALL empty for a single model (MODEL alone).
# With CASCADE_SMALL set, it classifies first; the ticket escalates to MODEL (the large model) when the
# small model predicts a category in CASCADE_ESCALATE (comma-separated), or when its call fails.
#   Setting A: MODEL=llama3.1:8b CASCADE_SMALL=qwen3:4b CASCADE_ESCALATE=Credit card,Debt collection CASCADE_SETTING=A
#   Setting B: MODEL=llama3.1:8b CASCADE_SMALL=qwen3:4b CASCADE_ESCALATE=Credit reporting,Debt collection CASCADE_SETTING=B
CASCADE_SMALL=
CASCADE_ESCALATE=
CASCADE_SETTING=

# All candidates pulled by the model-pull job (space separated)
CANDIDATE_MODELS=gemma3:4b llama3.1:8b qwen3:4b deepseek-r1:1.5b

# Inference settings, fixed across all candidates
TEMPERATURE=0
SEED=89
THINK=false

# Ollama image tag, pinned to the version verified via /api/version
OLLAMA_VERSION=0.35.1

# Database (local test credentials)
POSTGRES_VERSION=17
POSTGRES_DB= #Your own here
POSTGRES_USER= #Your own here
POSTGRES_PASSWORD= #Your own here

# Concurrency knobs. Assignment 1 ran with OLLAMA_MAX_LOADED_MODELS=1. Assignment 2 uses 2 so the
# cascade's small and large models stay loaded together; keep every value fixed for all A2 runs.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=-1
GUNICORN_THREADS=16
OLLAMA_TIMEOUT=600