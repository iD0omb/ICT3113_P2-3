# Model under test for this run. Must be one of the CANDIDATE_MODELS
MODEL=gemma3:4b

# All candidates pulled by the model-pull job (space separated)
CANDIDATE_MODELS=gemma3:4b llama3.1:8b qwen3:4b deepseek-r1:1.5b

# Inference settings, fixed across all candidates
TEMPERATURE=0
SEED=89
THINK=false

# Ollama image tag, pinned to the version verified via /api/version
OLLAMA_VERSION=0.35.1

# Database (local test credentials)
POSTGRES_VERSION=17
POSTGRES_DB= #Your own here
POSTGRES_USER= #Your own here
POSTGRES_PASSWORD= #Your own here

# Concurrency knobs (baseline values; tune in assignment 2)
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=-1
GUNICORN_THREADS=16
OLLAMA_TIMEOUT=600